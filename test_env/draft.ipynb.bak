      ]
    },
    {
      "cell_type": "markdown",
      "id": "f7788c96",
      "metadata": {},
      "source": [
        "## Env"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "id": "c0b87936",
      "metadata": {},
      "outputs": [],
      "source": [
        "\n",
        "EPS = 1e-8\n",
        "\n",
        "class MultiTimeframeForexEnv(gym.Env):\n",
        "    \"\"\"\n",
        "    Multi-Timeframe Forex Trading Environment for DQN\n",
        "    Actions: 0=close, 1=buy, 2=sell, 3=hold\n",
        "    Termination: 2% loss or 6% profit on trade\n",
        "    Features: Prevents future time leakage, supports walk-forward training\n",
        "    \"\"\"\n",
        "    \n",
        "    def __init__(self, \n",
        "                 lower_tf_data: pd.DataFrame,\n",
        "                 higher_tf_data: pd.DataFrame,\n",
        "                #  timeframe_ratio: int = 5,  # e.g., 5min/1min = 5\n",
        "                 initial_balance: float = 10000, \n",
        "                 lot_size: float = 0.1,\n",
        "                 stop_loss_pct: float = 0.02, \n",
        "                 take_profit_pct: float = 0.06,\n",
        "                 lookback_window: int = 20, \n",
        "                 transaction_cost: float = 0.0001,\n",
        "                 walk_forward_window: int = 2000,  # Training window size\n",
        "                 test=False,\n",
        "                 n_candles_to_test=None\n",
        "                 #validation_window: int = 500\n",
        "                 ):    # Validation window size\n",
        "        \n",
        "        super(MultiTimeframeForexEnv, self).__init__()\n",
        "        \n",
        "        self.test = test\n",
        "\n",
        "        # Data preparation\n",
        "        self.lower_tf_data = lower_tf_data.reset_index(drop=True).copy()\n",
        "        self.higher_tf_data = higher_tf_data.reset_index(drop=True).copy()\n",
        "        self._add_indicators()\n",
        "\n",
        "        self.lower_tf_data, self.ltf_scaler = self._scale_dataframe(\n",
        "            self.lower_tf_data,\n",
        "            exclude_cols=[\"time\"],\n",
        "            scaler_address=\"./test_env_data/lower_scaler.pkl\",\n",
        "        )\n",
        "\n",
        "        self.higher_tf_data, self.htf_scaler = self._scale_dataframe(\n",
        "            self.higher_tf_data,\n",
        "            exclude_cols=[\"time\"],\n",
        "            scaler_address=\"./test_env_data/higher_scaler.pkl\",\n",
        "        )\n",
        "\n",
        "\n",
        "        self.window_generator = TimeFrameWindowGen(self.higher_tf_data, \n",
        "                                                   self.lower_tf_data,\n",
        "                                                   higher_window_size=lookback_window, \n",
        "                                                   lower_window_size=lookback_window,\n",
        "                                                   htf_start_index=0,\n",
        "                                                   test=test,\n",
        "                                                   n_candles_to_test=n_candles_to_test)\n",
        "        \n",
        "        dfs = self.window_generator.cut_overlap()\n",
        "        self.higher_tf_data = dfs['htf_data']\n",
        "        self.lower_tf_data = dfs['ltf_data']\n",
        "        # self.timeframe_ratio = timeframe_ratio\n",
        "        \n",
        "        # Trading parameters\n",
        "        \n",
        "        self.initial_balance = initial_balance\n",
        "        self.lot_size = lot_size\n",
        "        self.stop_loss_pct = stop_loss_pct\n",
        "        self.take_profit_pct = take_profit_pct\n",
        "        self.lookback_window = lookback_window\n",
        "        self.transaction_cost = transaction_cost\n",
        "        \n",
        "        # Walk-forward parameters\n",
        "        self.walk_forward_window = walk_forward_window\n",
        "        # self.validation_window = validation_window\n",
        "        self.training_start = 0\n",
        "        self.training_end = walk_forward_window\n",
        "        self.normalize_value = self.initial_balance/10\n",
        "        # self.is_training = True\n",
        "        self.big_reward = 3.0\n",
        "        self.big_penalty = -1.0\n",
        "        \n",
        "        # Position tracking\n",
        "        self.current_position = 0.0\n",
        "        self.entry_price = None\n",
        "        self.current_step = 0\n",
        "        self.current_balance = initial_balance\n",
        "        self.trade_history = []\n",
        "        self.steps_in_trade = 0\n",
        "        # self.step_not_in_trade = 0\n",
        "        \n",
        "        # Action space: 0=close, 1=buy, 2=sell, 3=hold\n",
        "        self.action_space = spaces.Discrete(4)\n",
        "        \n",
        "        # State space (combo function output)\n",
        "        # self.observation_space = spaces.Box(\n",
        "        #     low=-np.inf, high=np.inf, \n",
        "        #     shape=(10,), dtype=np.float32\n",
        "        # )\n",
        "        \n",
        "        # Episode tracking\n",
        "        self.max_steps = len(self.lower_tf_data) - self.lookback_window - 1\n",
        "        \n",
        "        # Indicators cache for preventing future leakage\n",
        "        # self.lower_indicators_cache = {}\n",
        "        # self.higher_indicators_cache = {}\n",
        "        \n",
        "    \n",
        "    def _add_indicators(self) -> pd.DataFrame:  # OK\n",
        "        \n",
        "        # TODO Add return column\n",
        "        # TODO Scale the data!!!\n",
        "        close_price = self.lower_tf_data['mid_c'].copy()\n",
        "        high_price = self.lower_tf_data['mid_h'].copy()\n",
        "        low_price = self.lower_tf_data['mid_l'].copy()\n",
        "        volume = self.lower_tf_data['volume']\n",
        "\n",
        "        self.lower_tf_data['force_index'] = force_index(close=close_price, volume=volume)\n",
        "        # print(elder_ray(high=high_price, low=low_price, close=close_price).shape)\n",
        "        self.lower_tf_data['elder_ray_bull'], self.lower_tf_data['elder_ray_bear'] = elder_ray(high=high_price, low=low_price, close=close_price)\n",
        "        self.lower_tf_data['stochastic_k'], self.lower_tf_data['stochastic_d'] = stochastic_oscillator(high=high_price, low=low_price, close=close_price)\n",
        "        self.lower_tf_data['rsi'] = rsi(close=close_price)\n",
        "        self.lower_tf_data['ris'] = self.lower_tf_data['rsi']  # backward-compat (typo)\n",
        "        self.lower_tf_data['returns'] = self.lower_tf_data['mid_c'].pct_change()\n",
        "        self.lower_tf_data['returns_rolling_std'] = self.lower_tf_data['returns'].rolling(window=20).std()\n",
        "        self.lower_tf_data['log_return'] = np.log(self.lower_tf_data['mid_c'] / self.lower_tf_data['mid_c'].shift(1))\n",
        "        self.lower_tf_data['momentum'] = self.lower_tf_data['mid_c'] - self.lower_tf_data['mid_c'].shift(10)\n",
        "        short_vol = self.lower_tf_data['returns'].rolling(window=10).std() + EPS\n",
        "        long_vol = self.lower_tf_data['returns'].rolling(window=50).std() + EPS\n",
        "        self.lower_tf_data['vol_ratio'] = short_vol / (long_vol)\n",
        "\n",
        "        \n",
        "        close_price = self.higher_tf_data['mid_c'].copy()\n",
        "        \n",
        "        self.higher_tf_data['ema_26'] = ema_channel(close_price, ema_period=26, use_atr=False)\n",
        "        self.higher_tf_data['ema_13'] = ema_channel(close_price, ema_period=13, use_atr=False)\n",
        "        _, _, self.higher_tf_data['macd_hist'] =  macd(close=close_price)\n",
        "        self.higher_tf_data['impulse_system'] = impulse_system(close=close_price)\n",
        "        self.higher_tf_data['returns'] = self.higher_tf_data['mid_c'].pct_change()\n",
        "        self.higher_tf_data['returns_rolling_std'] = self.higher_tf_data['returns'].rolling(window=20).std()\n",
        "        self.higher_tf_data['log_return'] = np.log(self.higher_tf_data['mid_c'] / self.higher_tf_data['mid_c'].shift(1))\n",
        "        self.higher_tf_data['momentum'] = self.higher_tf_data['mid_c'] - self.higher_tf_data['mid_c'].shift(10)\n",
        "        short_vol = self.higher_tf_data['returns'].rolling(window=10).std()\n",
        "        long_vol = self.higher_tf_data['returns'].rolling(window=50).std()\n",
        "        self.higher_tf_data['vol_ratio'] = short_vol / (long_vol + 1e-8)\n",
        "\n",
        "        self.lower_tf_data.dropna(inplace=True)\n",
        "        self.higher_tf_data.dropna(inplace=True)\n",
        "        self.lower_tf_data.reset_index(drop=True, inplace=True)\n",
        "        self.higher_tf_data.reset_index(drop=True, inplace=True)\n",
        "\n",
        "    def _scale_dataframe(self, df, scaler_address, exclude_cols=['time']):\n",
        "        \"\"\"Scale all columns except those in exclude_cols.\n",
        "\n",
        "        Notes:\n",
        "        - Training mode (`test=False`): fit scaler on provided df, then save.\n",
        "        - Test mode (`test=True`): load existing scaler and ONLY transform.\n",
        "\n",
        "        This prevents refitting on test data.\n",
        "        \"\"\"\n",
        "\n",
        "        # Separate features to scale and those to exclude\n",
        "        cols_to_scale = [c for c in df.columns if c not in exclude_cols]\n",
        "\n",
        "        if not self.test:\n",
        "            scaler = StandardScaler()\n",
        "            scaled_values = scaler.fit_transform(df[cols_to_scale])\n",
        "            joblib.dump(scaler, scaler_address)\n",
        "        else:\n",
        "            scaler = joblib.load(scaler_address)\n",
        "            scaled_values = scaler.transform(df[cols_to_scale])\n",
        "\n",
        "        # Rebuild DataFrame\n",
        "        scaled_df = pd.DataFrame(scaled_values, columns=cols_to_scale, index=df.index)\n",
        "        \n",
        "        # Reattach excluded columns\n",
        "        for col in exclude_cols:\n",
        "            scaled_df[col] = df[col]\n",
        "        \n",
        "        # Reorder to original\n",
        "        scaled_df = scaled_df[df.columns]\n",
        "\n",
        "        \n",
        "        return scaled_df, scaler\n",
        "\n",
        "    # def _inverse_column_value(self, scaled_value, scaler, col_name):\n",
        "    #     cols_to_scale = [c for c in self.lower_tf_data.columns if c not in [\"time\"]]\n",
        "    #     idx = cols_to_scale.index(col_name)\n",
        "    #     mean = scaler.mean_[idx]\n",
        "    #     scale = scaler.scale_[idx]\n",
        "    #     return scaled_value * scale + mean\n",
        "\n",
        "    def _inverse_column_values(self, scaled_values, scaler, col_names):\n",
        "        \"\"\"\n",
        "        Inverses scaling for multiple columns.\n",
        "\n",
        "        Args:\n",
        "            scaled_values (list or np.ndarray): list of scaled values, same length as col_names\n",
        "            scaler (StandardScaler): fitted scaler used to scale the data\n",
        "            col_names (list of str): list of column names to inverse\n",
        "\n",
        "        Returns:\n",
        "            list: list of inversed (unscaled) values\n",
        "        \"\"\"\n",
        "        cols_to_scale = [c for c in self.lower_tf_data.columns if c not in [\"time\"]]\n",
        "\n",
        "        inversed_values = []\n",
        "        for val, col_name in zip(scaled_values, col_names):\n",
        "            idx = cols_to_scale.index(col_name)\n",
        "            mean = scaler.mean_[idx]\n",
        "            scale = scaler.scale_[idx]\n",
        "            inversed_values.append(val * scale + mean)\n",
        "        \n",
        "        return inversed_values\n",
        "\n",
        "    def set_walk_forward_window(self, start: int):  # OK\n",
        "        \"\"\"Align the environment to a new walk-forward start.\n",
        "\n",
        "        `start` is interpreted as a **lower timeframe (LTF) index** (M5 in this notebook).\n",
        "        \"\"\"\n",
        "\n",
        "        # Align using the lower timeframe index (matches `valid_idx()['ltf_range']` usage)\n",
        "        self.window_generator.alignment(ltf_start_index=start)\n",
        "    \n",
        "    def reset(self): # OK \n",
        "        \"\"\"Reset environment to initial state\"\"\"\n",
        "        # self.window_generator.reset()\n",
        "        self.current_balance = self.initial_balance\n",
        "        self.current_position = 0.0\n",
        "        self.entry_price = None\n",
        "        self.current_step = 0\n",
        "        # Start from training window beginning + lookback\n",
        "        # if self.is_training:\n",
        "        #     self.current_step = max(self.training_start + self.lookback_window, self.lookback_window)\n",
        "        # else:\n",
        "        #     self.current_step = max(self.training_end + self.lookback_window, self.lookback_window)\n",
        "        \n",
        "        self.trade_history = []\n",
        "        self.steps_in_trade = 0\n",
        "        \n",
        "        return self._get_state()\n",
        "    \n",
        "    def _get_state(self): # OK\n",
        "        \"\"\"Get current state using combo function\"\"\"\n",
        "        \n",
        "        higher_candles, lower_candles = self.window_generator.generate()\n",
        "        # higher_candles.drop(columns=[\"time\"], inplace=True)\n",
        "        # lower_candles.drop(columns=[\"time\"], inplace=True)\n",
        "\n",
        "        #state = self.combo(higher_candles, lower_candles)\n",
        "        \n",
        "        # data = (higher_candles, lower_candles)\n",
        "        # Add position information\n",
        "        position_info = np.array([\n",
        "            self.current_position / self.lot_size,  # -1, 0, or +1\n",
        "            (self._calculate_unrealized_pnl() / self.current_balance) * self.normalize_value,  # normalized unrealized P&L\n",
        "        ], dtype=np.float32)\n",
        "        \n",
        "        # Replace last 2 features with position info\n",
        "        # state[-2:] = position_info\n",
        "\n",
        "        state = {\n",
        "            'ltf_data': lower_candles,\n",
        "            'htf_data': higher_candles,\n",
        "            'position_info': position_info,\n",
        "        }\n",
        "        \n",
        "        return state\n",
        "    \n",
        "    def _calculate_unrealized_pnl(self): # OK\n",
        "        \"\"\"Calculate unrealized profit/loss\"\"\"\n",
        "        if self.current_position == 0.0 or self.entry_price is None:\n",
        "            return 0.0\n",
        "        \n",
        "        # current_price = self.lower_tf_data.iloc[self.current_step]['mid_c']\n",
        "        current_price = self.window_generator.get_current_value(column_names=['mid_c'], idx=0)[0]\n",
        "        current_price = self._inverse_column_values(scaled_values=[current_price], \n",
        "                                                   scaler=self.ltf_scaler, \n",
        "                                                   col_names=[\"mid_c\"])[0]\n",
        "\n",
        "        if self.current_position > 0:  # Long position\n",
        "            pnl = (current_price - self.entry_price) * abs(self.current_position) * 100000\n",
        "        else:  # Short position\n",
        "            pnl = (self.entry_price - current_price) * abs(self.current_position) * 100000\n",
        "            \n",
        "        return pnl\n",
        "    \n",
        "    def _get_valid_actions(self): # OK\n",
        "        \"\"\"Get valid actions based on current position\"\"\"\n",
        "        if self.current_position == 0.0:  # Flat\n",
        "            return [0, 1, 2]  # close(no-op), buy, sell\n",
        "        else:  # In position\n",
        "            return [0, 3]  # close, hold\n",
        "    \n",
        "    def step(self, action):\n",
        "        \"\"\"Execute one step in the environment\"\"\"\n",
        "        # current_price = self.lower_tf_data.iloc[self.current_step]['close']\n",
        "        current_price = self.window_generator.get_current_value(column_names=['mid_c'], idx=0)[0]\n",
        "        current_price = self._inverse_column_values(scaled_values=[current_price], \n",
        "                                                   scaler=self.ltf_scaler, \n",
        "                                                   col_names=[\"mid_c\"])[0]\n",
        "        # print('prince before action:', current_price)\n",
        "        # Execute action\n",
        "        reward = self._execute_action(action, current_price)\n",
        "        \n",
        "        # Check termination conditions\n",
        "        done = self._check_termination(current_price)\n",
        "        reward += done\n",
        "        done = 1 if done in [self.big_penalty, self.big_reward] else 0\n",
        "       \n",
        "        pos_type = None\n",
        "        # Move to next step\n",
        "        self.current_step += 1\n",
        "        if self.current_position != 0:\n",
        "            if self.current_position>0:\n",
        "                pos_type = 'Long'\n",
        "            else:\n",
        "                pos_type = 'Short'\n",
        "            self.steps_in_trade += 1\n",
        "\n",
        "        else:\n",
        "            pos_type = 'No Position'\n",
        "        \n",
        "        # Check if we've reached end of current window\n",
        "        # if self.is_training:\n",
        "        #     max_step = self.training_end - 1\n",
        "        # else:\n",
        "        #     max_step = min(self.training_end + self.validation_window - 1, self.max_steps)\n",
        "        \n",
        "        if self.current_step >= self.walk_forward_window: # max_step:\n",
        "            # print(f'done in {self.current_step}')\n",
        "            # print(' force done by walkforward window')\n",
        "            done = 1\n",
        "            # Force close any open position\n",
        "            if self.current_position != 0:\n",
        "                reward += self._close_position(current_price) # TODO what if the position is closed already\n",
        "                # print('pos forcly closed')\n",
        "        #  TODO: next_state handle in case of done \n",
        "        next_state = self._get_state() #if not done else None  # \n",
        "        # print('prince after action:', self.window_generator.get_current_price())\n",
        "        # print(\"*\"*20, self.is_training)\n",
        "        \n",
        "        info = {\n",
        "            'current_balance': self.current_balance,\n",
        "            'position_type': pos_type,\n",
        "            'current_position_size': self.current_position,\n",
        "            'unrealized_pnl': self._calculate_unrealized_pnl(),\n",
        "            'steps_in_trade': self.steps_in_trade,\n",
        "            # 'is_training': self.is_training,\n",
        "            # 'window_progress': (self.current_step - (self.training_start if self.is_training else self.training_end)) / \n",
        "            #                  (self.training_end - self.training_start if self.is_training else self.validation_window)\n",
        "        }\n",
        "        \n",
        "        return next_state, reward, done, info\n",
        "    \n",
        "    def _values_for_reward(self, needed_values_names:list, price_prev:bool=True):\n",
        "\n",
        "        \n",
        "        values_list = self.window_generator.get_current_value(needed_values_names,idx=0)\n",
        "        original_values = self._inverse_column_values(scaled_values=values_list, \n",
        "                                    scaler=self.ltf_scaler,\n",
        "                                    col_names=needed_values_names)\n",
        "        \n",
        "        momentum, returns_rolling_std, vol_ratio = original_values\n",
        "        price_prev = self.window_generator.get_current_value(column_names=['mid_c'], idx=1)[0]\n",
        "        price_prev = self._inverse_column_values(scaled_values=[price_prev], \n",
        "                                                   scaler=self.ltf_scaler, \n",
        "                                                   col_names=[\"mid_c\"])[0]\n",
        "        \n",
        "        return momentum, returns_rolling_std, vol_ratio, price_prev\n",
        "        \n",
        "    def _execute_action(self, action, current_price):  # OK\n",
        "        \"\"\"Execute the given action and return reward\"\"\"\n",
        "        needed_values_names = ['momentum', 'returns_rolling_std', 'vol_ratio']\n",
        "        momentum, returns_rolling_std, vol_ratio, price_prev = self._values_for_reward(needed_values_names)\n",
        "        \n",
        "        valid_actions = self._get_valid_actions()\n",
        "        if action not in valid_actions:\n",
        "            return -0.0001  # Invalid action penalty\n",
        "        \n",
        "        \n",
        "        reward = 0.0\n",
        "        \n",
        "        if action == 0:  # Close position\n",
        "            if self.current_position != 0:\n",
        "                reward = self._close_position(current_price)\n",
        "            \n",
        "        elif action == 1:  # Buy\n",
        "            if self.current_position == 0:\n",
        "                reward = self._open_position(current_price, self.lot_size)\n",
        "            \n",
        "        elif action == 2:  # Sell\n",
        "            if self.current_position == 0:\n",
        "                reward = self._open_position(current_price, -self.lot_size)\n",
        "                \n",
        "\n",
        "        elif action == 3:  # Hold\n",
        "            if self.current_position != 0:\n",
        "\n",
        "                ########### previous reward policy\n",
        "                # # Small time penalty + unrealized P&L signal\n",
        "                # unrealized_pnl = self._calculate_unrealized_pnl()\n",
        "                # reward = (unrealized_pnl / self.initial_balance) * self.normalize_value - 0.001 #time penalty\n",
        "                # if reward >= 0:\n",
        "                #     reward  += reward * 0.2 # incentive for staying in profitable trades\n",
        "                # else:\n",
        "                #     reward -= reward * 0.2\n",
        "                #############\n",
        "                step_in_trade = self.steps_in_trade\n",
        "                position_sign = np.sign(self.current_position)\n",
        "\n",
        "                reward = self.compute_reward_row(\n",
        "                    price=current_price,\n",
        "                    price_prev=price_prev,\n",
        "                    price_entry=self.entry_price,\n",
        "                    step_in_trade=step_in_trade,\n",
        "                    returns_rolling_std=returns_rolling_std,\n",
        "                    momentum=momentum,\n",
        "                    vol_ratio = vol_ratio,\n",
        "                    position_sign=position_sign,\n",
        "                    action_cost=self.transaction_cost,\n",
        "                    exit_score=0.0,  # no exit yet\n",
        "                )\n",
        "\n",
        "                # optional reward scaling\n",
        "                reward *= self.normalize_value\n",
        "            \n",
        "        return reward\n",
        "    \n",
        "    def compute_reward_row(self,\n",
        "        price, price_prev, price_entry, step_in_trade,\n",
        "        returns_rolling_std, momentum, vol_ratio,\n",
        "        action_cost=0.0005,  # e.g. 5 bps per step\n",
        "        position_sign=+1,    # +1 long, -1 short\n",
        "        Tmax=50,\n",
        "        weights = dict(wR=0.5, wA=0.2, wT=0.15, wV=0.1, wE=0.1, wC=1.0),\n",
        "        exit_score=0.0\n",
        "    ):\n",
        "        # simple/relative returns\n",
        "        r_t = (price - price_prev) / (price_prev + EPS)\n",
        "        R_entry = (price - price_entry) / (price_entry + EPS)\n",
        "\n",
        "        sigma = returns_rolling_std + EPS\n",
        "        \n",
        "\n",
        "        # standardized quantities\n",
        "        R_std = R_entry / sigma\n",
        "        r_std = r_t / sigma\n",
        "        M_std = momentum / sigma\n",
        "\n",
        "        # regime score V_t\n",
        "        Vt = np.tanh(M_std) * np.tanh(vol_ratio - 1.0)  # in (-1,1)\n",
        "\n",
        "        # exit bonus (bounded)\n",
        "        exit_bonus = np.tanh(exit_score)\n",
        "\n",
        "        # bounded transforms\n",
        "        BR = np.tanh(R_std)\n",
        "        BA = np.tanh(position_sign * r_std)   # rewards favorable instantaneous move\n",
        "\n",
        "        time_penalty = (step_in_trade / Tmax)  # grows to 1\n",
        "\n",
        "        wR, wA, wT, wV, wE, wC = (weights[k] for k in (\"wR\",\"wA\",\"wT\",\"wV\",\"wE\",\"wC\"))\n",
        "\n",
        "        reward = (\n",
        "            wR * BR +\n",
        "            wA * BA -\n",
        "            wT * time_penalty +\n",
        "            wV * Vt * np.tanh(M_std) +\n",
        "            wE * exit_bonus -\n",
        "            wC * action_cost\n",
        "        )\n",
        "        return float(reward)\n",
        "    \n",
        "\n",
        "    def _open_position(self, price, position_size):  # OK \n",
        "        \"\"\"Open a new position\"\"\"\n",
        "        self.current_position = position_size\n",
        "        self.entry_price = price\n",
        "        self.steps_in_trade = 0\n",
        "        \n",
        "        # Transaction cost\n",
        "        transaction_cost = abs(position_size) * 100000 * self.transaction_cost\n",
        "        # print('Transaction cost', transaction_cost)\n",
        "        self.current_balance -= transaction_cost\n",
        "        \n",
        "        return -0.005  # Small penalty\\incentive for opening position\n",
        "    \n",
        "    def _close_position(self, price): # OK\n",
        "        \"\"\"Close current position and return realized P&L\"\"\"\n",
        "        if self.current_position == 0:\n",
        "            return 0.0\n",
        "\n",
        "        position_sign = np.sign(self.current_position)\n",
        "        pnl = (price - self.entry_price) * position_sign * abs(self.current_position) * 100000\n",
        "        self.current_balance += pnl\n",
        "        exit_score = np.sign(pnl) * np.tanh(abs(pnl) / self.initial_balance)\n",
        "        \n",
        "\n",
        "        needed_values_names = ['momentum', 'returns_rolling_std', 'vol_ratio']\n",
        "        momentum, returns_rolling_std, vol_ratio, price_prev = self._values_for_reward(needed_values_names)\n",
        "\n",
        "        base_reward = self.compute_reward_row(\n",
        "            price=price,\n",
        "            price_prev=price_prev,\n",
        "            price_entry=self.entry_price,\n",
        "            step_in_trade=self.steps_in_trade,\n",
        "            returns_rolling_std=returns_rolling_std,\n",
        "            momentum=momentum,\n",
        "            vol_ratio=vol_ratio,\n",
        "            position_sign=position_sign,\n",
        "            action_cost=self.transaction_cost,\n",
        "            exit_score=exit_score,\n",
        "        )\n",
        "\n",
        "        trade_reward = base_reward * self.normalize_value\n",
        "\n",
        "        # transaction_cost = abs(self.current_position) * 100000 * self.transaction_cost\n",
        "        \n",
        "        success = (pnl > 0)\n",
        "\n",
        "        self.trade_history.append({\n",
        "            'entry_price': self.entry_price,\n",
        "            'exit_price': price,\n",
        "            'position':'Long' if self.current_position>0 else 'Short',\n",
        "            'position_size': self.current_position,\n",
        "            'pnl': pnl,\n",
        "            'steps_in_trade': self.steps_in_trade,\n",
        "            'success':success,\n",
        "            # 'entry_step': self.current_step - self.steps_in_trade,\n",
        "            'exit_step': self.current_step\n",
        "        })\n",
        "        \n",
        "\n",
        "        # Reset position\n",
        "        self.current_position = 0.0\n",
        "        self.entry_price = None\n",
        "        self.steps_in_trade = 0\n",
        "        \n",
        "\n",
        "        return  trade_reward\n",
        "    \n",
        "    def _check_termination(self, current_price): # Ok\n",
        "        \"\"\"Check if episode should terminate\"\"\"\n",
        "        if self.current_position == 0:\n",
        "            return 0 # False\n",
        "        \n",
        "        unrealized_pnl = self._calculate_unrealized_pnl()\n",
        "        # trade_value = abs(self.current_position) * 100000 * self.entry_price\n",
        "        \n",
        "        # Stop loss: 2% loss\n",
        "        if unrealized_pnl <= -self.initial_balance * self.stop_loss_pct: # -trade_value * self.stop_loss_pct:\n",
        "            self._close_position(current_price)\n",
        "            print(f'\\tsl meet with {unrealized_pnl:.2f}$ loss')\n",
        "            return self.big_penalty\n",
        "        \n",
        "        # Take profit: 6% profit\n",
        "        if unrealized_pnl >= self.initial_balance * self.take_profit_pct: # trade_value * self.take_profit_pct:\n",
        "            self._close_position(current_price)\n",
        "            print(f'\\ttp meet with {unrealized_pnl:.2f}$ profit')\n",
        "            return self.big_reward\n",
        "        \n",
        "        return 0 # False\n",
        "\n",
        "    def action_to_name(self,act_num:int):\n",
        "        act_dict = {0:'Close/No Op',\n",
        "                    1:\"Buy\",\n",
        "                    2:\"Sell\",\n",
        "                    3:\"Hold\"}\n",
        "        if act_num not in act_dict.keys():\n",
        "            print(f\"{act_num} is not a valid action!\")\n",
        "        else:\n",
        "            return act_dict[act_num]\n",
        "        \n",
        "    def get_current_price(self):\n",
        "        current_price = self.window_generator.get_current_value(column_names=['mid_c'], idx=0)[0]\n",
        "        current_price = self._inverse_column_values(scaled_values=[current_price], \n",
        "                                                   scaler=self.ltf_scaler, \n",
        "                                                   col_names=[\"mid_c\"])[0]\n",
        "        return current_price\n",
        "    \n",
        "    def get_trade_statistics(self):\n",
        "        \"\"\"Get trading statistics\"\"\"\n",
        "        if not self.trade_history:\n",
        "            return {}\n",
        "        \n",
        "        trades_df = pd.DataFrame(self.trade_history)\n",
        "        \n",
        "        stats = {\n",
        "            'total_trades': len(trades_df),\n",
        "            'winning_trades': len(trades_df[trades_df['pnl'] > 0]),\n",
        "            'losing_trades': len(trades_df[trades_df['pnl'] < 0]),\n",
        "            'total_pnl': trades_df['pnl'].sum(),\n",
        "            'average_pnl': trades_df['pnl'].mean(),\n",
        "            'max_profit': trades_df['pnl'].max(),\n",
        "            'max_loss': trades_df['pnl'].min(),\n",
        "            'win_rate': len(trades_df[trades_df['pnl'] > 0]) / len(trades_df) * 100,\n",
        "            'average_trade_duration': trades_df['steps_in_trade'].mean(),\n",
        "            'sharpe_ratio': trades_df['pnl'].mean() / (trades_df['pnl'].std() + 1e-8) if len(trades_df) > 1 else 0.0,\n",
        "            'final_balance': self.current_balance\n",
        "        }\n",
        "        \n",
        "        return stats\n",
        "\n",
        "env = MultiTimeframeForexEnv(\n",
        "        lower_tf_data=m5_data_filtered,\n",
        "        higher_tf_data=m30_data_filtered,\n",
        "        # timeframe_ratio=5,\n",
        "        walk_forward_window=2000,\n",
        "        # validation_window=500\n",
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 19,
      "id": "893a18cf",
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "EPS = 1e-8\n",
        "\n",
        "def compute_reward_row(\n",
        "    price, price_prev, price_entry, step_in_trade,\n",
        "    returns_rolling_std, momentum, short_vol, long_vol,\n",
        "    action_cost=0.0005,  # e.g. 5 bps per step\n",
        "    position_sign=+1,    # +1 long, -1 short\n",
        "    Tmax=50,\n",
        "    weights = dict(wR=0.5, wA=0.2, wT=0.15, wV=0.1, wE=0.1, wC=1.0),\n",
        "    exit_score=0.0\n",
        "):\n",
        "    # simple/relative returns\n",
        "    r_t = (price - price_prev) / (price_prev + EPS)\n",
        "    R_entry = (price - price_entry) / (price_entry + EPS)\n",
        "\n",
        "    sigma = returns_rolling_std + EPS\n",
        "    std_short = short_vol + EPS\n",
        "    std_long = long_vol + EPS\n",
        "\n",
        "    # standardized quantities\n",
        "    R_std = R_entry / sigma\n",
        "    r_std = r_t / sigma\n",
        "    M_std = momentum / sigma\n",
        "\n",
        "    # regime score V_t\n",
        "    vol_ratio = std_short / std_long\n",
        "    Vt = np.tanh(M_std) * np.tanh(vol_ratio - 1.0)  # in (-1,1)\n",
        "\n",
        "    # exit bonus (bounded)\n",
        "    exit_bonus = np.tanh(exit_score)\n",
        "\n",
        "    # bounded transforms\n",
        "    BR = np.tanh(R_std)\n",
        "    BA = np.tanh(position_sign * r_std)   # rewards favorable instantaneous move\n",
        "\n",
        "    time_penalty = (step_in_trade / Tmax)  # grows to 1\n",
        "\n",
        "    wR, wA, wT, wV, wE, wC = (weights[k] for k in (\"wR\",\"wA\",\"wT\",\"wV\",\"wE\",\"wC\"))\n",
        "\n",
        "    reward = (\n",
        "        wR * BR +\n",
        "        wA * BA -\n",
        "        wT * time_penalty +\n",
        "        wV * Vt * np.tanh(M_std) +\n",
        "        wE * exit_bonus -\n",
        "        wC * action_cost\n",
        "    )\n",
        "    return float(reward)"
      ]
    },
