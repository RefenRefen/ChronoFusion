      "metadata": {},
      "outputs": [],
      "source": [
        "\n",
        "q_network = QModel(\n",
        "    input_dim_low=x_low.shape[2], \n",
        "    input_dim_high=x_high.shape[2],\n",
        "    pos_info_dim=pos_info.shape[1],\n",
        "    fusion_dim=64\n",
        ").to(device)\n",
        "\n",
        "\n",
        "target_q_network = QModel(\n",
        "    input_dim_low=x_low.shape[2], \n",
        "    input_dim_high=x_high.shape[2],\n",
        "    pos_info_dim=pos_info.shape[1],\n",
        "    fusion_dim=64\n",
        ").to(device)\n",
        "\n",
        "optimizer = optim.Adam(q_network.parameters(), lr=ALPHA)\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 48,
      "id": "11798e6a",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
