    {
      "cell_type": "code",
      "execution_count": 43,
      "id": "f43d4547",
      "metadata": {},
      "outputs": [],
      "source": [
        "n_candle_to_train = 3000\n",
        "lower_tf_data = m5_data_filtered[:n_candle_to_train].copy()\n",
        "higher_tf_data = m30_data_filtered[:n_candle_to_train//6].copy()\n",
        "\n",
        "\n",
        "env = MultiTimeframeForexEnv(\n",
        "    lower_tf_data=lower_tf_data,\n",
        "    higher_tf_data=higher_tf_data,\n",
        "    walk_forward_window=WALK_FORWARD_WINDOW,\n",
        "    lookback_window=LOOKBACK_WINDOW_SIZE,\n",
        "    # walk_forward_window=100,\n",
        "    stop_loss_pct=STOP_LOSS_PCT, #0.0015,\n",
        "    take_profit_pct=TAKE_PROFIT_PCT\n",
        ")\n",
        "\n",
        "\n",
        "current_state = env.reset()\n",
        "\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "\n",
        "x_low, x_high, pos_info = state_to_tensor(current_state, device=device)"
      ]
    },
