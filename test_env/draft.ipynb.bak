      "metadata": {},
      "source": [
        "## Walk Forward Generator"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "id": "e8033b30",
      "metadata": {},
      "outputs": [],
      "source": [
        "def create_walk_forward_trainer(\n",
        "                               total_steps: int,\n",
        "                               window_size: int = 2000,\n",
        "                               overlap: int = 200):\n",
        "    \"\"\"\n",
        "    Create walk-forward training windows\n",
        "    \n",
        "    Example:\n",
        "    - Window 1: Train 0-2000, \n",
        "    - Window 2: Train 1800-3800, \n",
        "    - Window 3: Train 3600-5600\n",
        "    \"\"\"\n",
        "    windows = []\n",
        "    start = 0\n",
        "    \n",
        "    while start + window_size  < total_steps:\n",
        "        train_start = start\n",
        "        train_end = start + window_size\n",
        "        \n",
        "        windows.append({\n",
        "            'train_start': train_start,\n",
        "            'train_end': train_end,\n",
        "        })\n",
        "        \n",
        "        start += window_size - overlap\n",
        "    \n",
        "    return windows\n"
      ]
    },
