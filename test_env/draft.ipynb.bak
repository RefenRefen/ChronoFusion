    {
      "cell_type": "markdown",
      "id": "cec6372a",
      "metadata": {},
      "source": [
        "## QModel"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 30,
      "id": "90fe7d3a",
      "metadata": {},
      "outputs": [],
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "class QModel(nn.Module):\n",
        "    def __init__(self, \n",
        "                 input_dim_low, input_dim_high, \n",
        "                 d_model=256, nhead=4, num_layers=5,\n",
        "                 fusion_dim=100,\n",
        "                 pos_info_dim=10):  # <- length of extra array\n",
        "        super().__init__()\n",
        "\n",
        "        # Multi-scale transformer backbone\n",
        "        self.backbone = MultiScaleTransformer(\n",
        "            input_dim_low=input_dim_low,\n",
        "            input_dim_high=input_dim_high,\n",
        "            d_model=d_model,\n",
        "            nhead=nhead,\n",
        "            num_layers=num_layers,\n",
        "            output_dim=fusion_dim\n",
        "        )\n",
        "\n",
        "        # Regression head: (100 + extra_dim) → ... → 4\n",
        "        self.reg_head = nn.Sequential(\n",
        "            nn.Linear(fusion_dim + pos_info_dim, 256),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(256, 128),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(128, 64),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(64, 4)   # 4 outputs for regression\n",
        "        )\n",
        "\n",
        "    def forward(self, x_low, x_high, pos_info):\n",
        "        \"\"\"\n",
        "        x_low: (batch, seq_len, input_dim_low)\n",
        "        x_high: (batch, seq_len, input_dim_high)\n",
        "        pos_info: (batch, extra_dim)\n",
        "        \"\"\"\n",
        "        fused = self.backbone(x_low, x_high)  # (batch, 100)\n",
        "\n",
        "        # concat with extra input\n",
        "        combined = torch.cat([fused, pos_info], dim=-1)  # (batch, 100+extra_dim)\n",
        "\n",
        "        # regression output\n",
        "        out = self.reg_head(combined)  # (batch, 4)\n",
        "\n",
        "        return out\n"
      ]
    },
    {
