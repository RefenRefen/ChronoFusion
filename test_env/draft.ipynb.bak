      "source": [
        "# DQN"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 33,
      "id": "c5f1a6fa",
      "metadata": {},
      "outputs": [],
      "source": [
        "MEMORY_SIZE = 30_000     # size of memory buffer\n",
        "GAMMA = 0.995             # discount factor\n",
        "ALPHA = 1e-6              # learning rate  \n",
        "NUM_STEPS_FOR_UPDATE = 4  # perform a learning update every C time steps\n",
        "LOOKBACK_WINDOW_SIZE = 26\n",
        "WALK_FORWARD_WINDOW = 50\n",
        "\n",
        "STOP_LOSS_PCT = 0.001\n",
        "TAKE_PROFIT_PCT = 0.003\n",
        "\n",
        "SEED = 0  # Seed for the pseudo-random number generator.\n",
        "MINIBATCH_SIZE = 64  # Mini-batch size.\n",
        "TAU = 1e-4  # Soft update parameter.\n",
        "E_DECAY = 0.995  # ε-decay rate for the ε-greedy policy.\n",
        "E_MIN = 0.01 # 0.01  # Minimum ε value for the ε-greedy policy."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 34,
      "id": "977c70ee",
      "metadata": {},
      "outputs": [],
      "source": [
        "# state_size = env.observation_space.shape\n",
        "num_actions = env.action_space.n\n",
        "# print(num_actions)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 35,
      "id": "dcaceb43",
      "metadata": {},
      "outputs": [],
      "source": [
        "# m30_data_filtered[-10:-1]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 36,
      "id": "8be7874d",
      "metadata": {},
      "outputs": [],
      "source": [
        "# m5_data_filtered[-10:-1]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 37,
      "id": "1960e433",
      "metadata": {},
      "outputs": [],
      "source": [
        "def pack_state(state):\n",
        "    \"\"\"Pack a dict-state into compact numeric arrays for replay memory.\n",
        "\n",
        "    Returns:\n",
        "        (x_low_np, x_high_np, pos_np) as float32 numpy arrays.\n",
        "    \"\"\"\n",
        "    ltf_window = state[\"ltf_data\"]\n",
        "    htf_window = state[\"htf_data\"]\n",
        "\n",
        "    ltf_numeric = ltf_window.select_dtypes(include=[\"number\"])\n",
        "    htf_numeric = htf_window.select_dtypes(include=[\"number\"])\n",
        "\n",
        "    if \"position_info\" not in state:\n",
        "        raise KeyError(\"state must contain 'position_info'\")\n",
        "\n",
        "    pos = state[\"position_info\"]\n",
        "\n",
        "    x_low_np = ltf_numeric.values.astype(\"float32\", copy=False)\n",
        "    x_high_np = htf_numeric.values.astype(\"float32\", copy=False)\n",
        "    pos_np = np.asarray(pos, dtype=\"float32\")\n",
        "\n",
        "    return x_low_np, x_high_np, pos_np\n",
        "\n",
        "\n",
        "def state_to_tensor(state, device=\"cpu\"):\n",
        "    \"\"\"Convert a state (dict OR packed tuple) to model input tensors.\"\"\"\n",
        "\n",
        "    if isinstance(state, dict):\n",
        "        x_low_np, x_high_np, pos_np = pack_state(state)\n",
        "    else:\n",
        "        # packed (x_low_np, x_high_np, pos_np)\n",
        "        x_low_np, x_high_np, pos_np = state\n",
        "\n",
        "    x_low = torch.as_tensor(x_low_np, dtype=torch.float32, device=device)\n",
        "    x_high = torch.as_tensor(x_high_np, dtype=torch.float32, device=device)\n",
        "    pos_info = torch.as_tensor(pos_np, dtype=torch.float32, device=device)\n",
        "\n",
        "    return x_low.unsqueeze(0), x_high.unsqueeze(0), pos_info.unsqueeze(0)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 38,
      "id": "0e8103a6",
      "metadata": {},
      "outputs": [],
      "source": [
        "def states_list_to_tensors(states, device='cpu'):\n",
        "    \"\"\"\n",
        "    Converts a batch of states (list of dicts) into batched tensors\n",
        "    suitable for NN input.\n",
        "\n",
        "    Each state dict has:\n",
        "        - 'ltf_data': DataFrame\n",
        "        - 'htf_data': DataFrame\n",
        "        - 'position_info': list or array\n",
        "    \n",
        "    Returns:\n",
        "        x_low:  Tensor [batch_size, L, num_features_low]\n",
        "        x_high: Tensor [batch_size, H, num_features_high]\n",
        "        pos_info: Tensor [batch_size, pos_dim]\n",
        "    \"\"\"\n",
        "    x_low_list = []\n",
        "    x_high_list = []\n",
        "    pos_list = []\n",
        "\n",
        "    for state in states:\n",
        "        if isinstance(state, dict):\n",
        "            x_low_np, x_high_np, pos_np = pack_state(state)\n",
        "        else:\n",
        "            x_low_np, x_high_np, pos_np = state\n",
        "\n",
        "        x_low_list.append(torch.as_tensor(x_low_np, dtype=torch.float32, device=device))\n",
        "        x_high_list.append(torch.as_tensor(x_high_np, dtype=torch.float32, device=device))\n",
        "        pos_list.append(torch.as_tensor(pos_np, dtype=torch.float32, device=device))\n",
        "\n",
        "    # Stack into batch dimension\n",
        "    x_low = torch.stack(x_low_list, dim=0)    # [B, L, low_feats]\n",
        "    x_high = torch.stack(x_high_list, dim=0)  # [B, H, high_feats]\n",
        "    pos_info = torch.stack(pos_list, dim=0)   # [B, pos_dim]\n",
        "\n",
        "    return x_low, x_high, pos_info\n"
      ]
    },
    {
