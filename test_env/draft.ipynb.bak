      "source": [
        "one_counter = 0\n",
        "two_counter = 0\n",
        "zero_counter = 0\n",
        "three_counter = 0\n",
        "for e in memory_buffer:\n",
        "    if e.action == 1:\n",
        "        one_counter +=1\n",
        "    elif e.action == 2:\n",
        "        two_counter +=1\n",
        "    elif e.action == 0:\n",
        "        zero_counter +=1\n",
        "    else:\n",
        "        three_counter +=1\n",
        "\n",
        "print('ones', one_counter)\n",
        "print('twos', two_counter)\n",
        "print('zeros', zero_counter)\n",
        "print('threes', three_counter)"
      ]
    },
