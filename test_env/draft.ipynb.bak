    {
      "cell_type": "markdown",
      "id": "9bf27631",
      "metadata": {},
      "source": [
        "## Window Generator"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "56e10ec2",
      "metadata": {},
      "outputs": [],
      "source": [
        "class TimeFrameWindowGen:\n",
        "    def __init__(self, \n",
        "                 higher_tf_data:pd.DataFrame, \n",
        "                 lower_tf_data:pd.DataFrame, \n",
        "                 higher_window_size:int = 50, \n",
        "                 lower_window_size:int = 50,\n",
        "                 htf_start_index=0,\n",
        "                 test=False,\n",
        "                 n_candles_to_test:int=None):\n",
        "        \n",
        "        if test and not n_candles_to_test:\n",
        "            raise InvalidArgumentError('Specify the n_candles_to_test!')\n",
        "        # self.timestep = 0\n",
        "        self.htf_data = higher_tf_data\n",
        "        self.ltf_data = lower_tf_data\n",
        "        self.h_window_size = higher_window_size\n",
        "        self.l_window_size = lower_window_size\n",
        "        self.lower_last_candle_index_for_test=None\n",
        "        self.n_candles_to_test = n_candles_to_test\n",
        "        self.htf_start_index = htf_start_index\n",
        "        self.test = test\n",
        "        dfs = self.cut_overlap(htf_start_index)\n",
        "        self.htf_data = dfs['htf_data']\n",
        "        self.ltf_data = dfs['ltf_data']\n",
        "        self.alignment(htf_start_index=htf_start_index)\n",
        "\n",
        "    def alignment(self, htf_start_index: int=None, ltf_start_index=None):\n",
        "        if htf_start_index is not None:\n",
        "            self.higher_last_candle_index = self.h_window_size - 1 + htf_start_index\n",
        "            if self.higher_last_candle_index >= self.htf_data.shape[0]:\n",
        "                raise NotAvailableData(index=self.higher_last_candle_index, data_frame_scale='higher')\n",
        "            \n",
        "            # time_to_align = self.htf_data['time'].iloc[self.higher_last_candle_index]\n",
        "            # aligned_index = self.ltf_data.index[self.ltf_data[\"time\"] == time_to_align]\n",
        "            aligned_index = self.index_match(time_df=self.htf_data, \n",
        "                                            index_df=self.ltf_data,\n",
        "                                            index_to_align=self.higher_last_candle_index)\n",
        "            \n",
        "            self.lower_last_candle_index = aligned_index[0]\n",
        "            \n",
        "            if self.test:\n",
        "                self.lower_last_candle_index_for_test = aligned_index[0] + self.n_candles_to_test\n",
        "\n",
        "        elif ltf_start_index is not None:\n",
        "            self.lower_last_candle_index =  ltf_start_index - 1 # + self.l_window_size \n",
        "            if self.lower_last_candle_index >= self.ltf_data.shape[0]:\n",
        "                raise NotAvailableData(index=self.lower_last_candle_index, data_frame_scale='lower')\n",
        "            \n",
        "            # aligned_index = self.index_match(time_df=self.ltf_data, \n",
        "            #                                 index_df=self.htf_data,\n",
        "            #                                 index_to_align=self.lower_last_candle_index)\n",
        "\n",
        "            \n",
        "            self.higher_last_candle_index = self.nearest_past_index(index_to_align=self.lower_last_candle_index)\n",
        "            if self.test:\n",
        "                self.lower_last_candle_index_for_test = self.lower_last_candle_index + self.n_candles_to_test\n",
        "    def index_match(self,time_df, index_df, index_to_align):\n",
        "        time_to_align = time_df['time'].iloc[index_to_align]\n",
        "        # print('time_to_align', time_to_align)\n",
        "        aligned_index = index_df.index[index_df[\"time\"] == time_to_align]\n",
        "        if aligned_index.empty:\n",
        "            raise NonOverlappingData()\n",
        "        return aligned_index\n",
        "    \n",
        "    def nearest_past_index(self, index_to_align):\n",
        "        time_to_align = self.ltf_data['time'].iloc[index_to_align]\n",
        "        # print('time to aling*****************', time_to_align)\n",
        "        return self.htf_data.loc[self.htf_data['time'] <= time_to_align, 'time'].idxmax()\n",
        "\n",
        "    def reset(self, idx_high=None, idx_low=None):\n",
        "        if idx_high is not None:\n",
        "            self.alignment(htf_start_index=idx_high)\n",
        "        elif idx_low is not None:\n",
        "            self.alignment(ltf_start_index=idx_low)\n",
        "        else:\n",
        "            self.alignment(self.htf_start_index)\n",
        "\n",
        "    \n",
        "    def generate(self):\n",
        "        \n",
        "        start = self.higher_last_candle_index - self.h_window_size + 1\n",
        "        end = self.higher_last_candle_index + 1\n",
        "        if end >= self.htf_data.shape[0]:\n",
        "            print('lower_window_start:', self.lower_last_candle_index - self.l_window_size + 1)\n",
        "            print('lower_window_end:', self.lower_last_candle_index + 1)\n",
        "            raise NotAvailableData(index=end, data_frame_scale='higher')\n",
        "        if start >= self.htf_data.shape[0]:\n",
        "            raise NotAvailableData(index=start, data_frame_scale='higher')\n",
        "        \n",
        "        higher_fraction = self.htf_data[start:end]\n",
        "\n",
        "        start = self.lower_last_candle_index - self.l_window_size + 1 \n",
        "        end = self.lower_last_candle_index + 1\n",
        "\n",
        "        if end >= self.ltf_data.shape[0]:\n",
        "           raise NotAvailableData(index=end, data_frame_scale='lower')\n",
        "        if start >= self.ltf_data.shape[0]:\n",
        "           raise NotAvailableData(index=start, data_frame_scale='lower')\n",
        "        \n",
        "        if self.test and end > self.lower_last_candle_index_for_test:\n",
        "            raise WrongMode()\n",
        "        \n",
        "        lower_fraction = self.ltf_data[start:end]\n",
        "            \n",
        "        # self.timestep += 1\n",
        "        self.lower_last_candle_index += 1\n",
        "\n",
        "        higher_time_delta = self.htf_data['time'].iloc[self.higher_last_candle_index] - \\\n",
        "                            self.htf_data['time'].iloc[self.higher_last_candle_index-1]\n",
        "        \n",
        "        if self.htf_data['time'].iloc[self.higher_last_candle_index] + higher_time_delta <=\\\n",
        "           self.ltf_data['time'].iloc[self.lower_last_candle_index]:\n",
        "            \n",
        "            self.higher_last_candle_index += 1\n",
        "        \n",
        "\n",
        "        return higher_fraction, lower_fraction\n",
        "    \n",
        "    def get_current_value(self, column_names=['mid_c'], idx=0):\n",
        "        \"\"\" Return the current vlaue of a column_name if idx, but for previous one \n",
        "        for example idx=1\"\"\"\n",
        "        curr_price_index  = self.lower_last_candle_index - 1 - idx\n",
        "        list_of_values = self.ltf_data[column_names].iloc[curr_price_index]\n",
        "        return list(list_of_values)\n",
        "    \n",
        "\n",
        "    \n",
        "    def get_test_df(self):\n",
        "        if self.test:\n",
        "            end = self.lower_last_candle_index_for_test\n",
        "            lower_fraction_for_test = self.ltf_data[end-self.n_candles_to_test:end]\n",
        "            return lower_fraction_for_test\n",
        "        else:\n",
        "            raise WrongMode(true_mode='test', wrong_mode='train')\n",
        "        \n",
        "    def cut_overlap(self, idx=None):\n",
        "        \"\"\" Cutting overlapping pieces of dataframes\"\"\"\n",
        "        beginning_idx = idx if idx else 0\n",
        "        self.alignment(htf_start_index=beginning_idx)\n",
        "\n",
        "        ltf_start = self.lower_last_candle_index - self.l_window_size + 1\n",
        "        htf_start = self.higher_last_candle_index - self.h_window_size + 1\n",
        "\n",
        "        idx_to_test = self.htf_data.shape[0]-1\n",
        "\n",
        "        while idx_to_test >=0 :\n",
        "            try:\n",
        "                aligned_index = self.index_match(time_df=self.htf_data, \n",
        "                                                index_df=self.ltf_data,\n",
        "                                                index_to_align=idx_to_test)\n",
        "                break\n",
        "            except:\n",
        "                idx_to_test -= 1\n",
        "        # print('htf_start', htf_start)\n",
        "        # print('idx_to_test', idx_to_test)\n",
        "\n",
        "        return {'htf_data':self.htf_data[htf_start:idx_to_test].reset_index(drop=True),\n",
        "                'ltf_data':self.ltf_data[ltf_start:aligned_index[0]].reset_index(drop=True)}\n",
        "    \n",
        "    def valid_idx(self, walk_forward_window, idx=None, time_ratio=6):\n",
        "        dfs = self.cut_overlap(idx=idx)\n",
        "        h_max = dfs['htf_data'].shape[0]\n",
        "        l_max = dfs['ltf_data'].shape[0]\n",
        "        valid_idx_range = {'htf_range':(0+self.h_window_size, h_max-1 - walk_forward_window//time_ratio -1),\n",
        "                           'ltf_range':(0+self.l_window_size, l_max - walk_forward_window - 2)}\n",
        "        return valid_idx_range\n",
        "\n",
        "        \n",
        "\n",
        "        "
      ]
    },
    {
