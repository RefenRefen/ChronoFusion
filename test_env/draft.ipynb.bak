      "source": [
        "lower_tf_data = m5_data_filtered[:12000].copy()\n",
        "higher_tf_data = m30_data_filtered[:2000].copy()\n",
        "n_candles_to_test = 200\n",
        "\n",
        "env = MultiTimeframeForexEnv(\n",
        "    lower_tf_data=lower_tf_data,\n",
        "    higher_tf_data=higher_tf_data,\n",
        "    walk_forward_window=n_candles_to_test,\n",
        "    lookback_window=LOOKBACK_WINDOW_SIZE,\n",
        "    # walk_forward_window=100,\n",
        "    stop_loss_pct=STOP_LOSS_PCT, #0.0015,\n",
        "    take_profit_pct=TAKE_PROFIT_PCT,\n",
        "    test=True,\n",
        "    n_candles_to_test=n_candles_to_test\n",
        ")\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "current_state = env.reset()\n",
        "\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "\n",
        "x_low, x_high, pos_info = state_to_tensor(current_state, device=device)\n",
        "\n",
        "q_network = QModel(\n",
        "    input_dim_low=x_low.shape[2], \n",
        "    input_dim_high=x_high.shape[2],\n",
        "    pos_info_dim=pos_info.shape[1],\n",
        "    fusion_dim=64\n",
        ").to(device)\n",
        "\n",
        "state_dict = torch.load(\"converged_model.pth\", map_location=device)\n",
        "q_network.load_state_dict(state_dict)\n",
        "\n",
        "q_network.eval()"
      ]
    },
