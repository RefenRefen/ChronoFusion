      "source": [
        "action_list = []\n",
        "current_state = env.reset()\n",
        "with torch.no_grad():\n",
        "    for t in range(n_candles_to_test-2):\n",
        "        # print(current_state['ltf_data'])\n",
        "        \n",
        "        # From the current state S choose an action A using an ε-greedy policy\n",
        "        x_low, x_high, pos_info = state_to_tensor(current_state, device=device)\n",
        "        q_values = q_network(x_low, x_high, pos_info)\n",
        "        print('\\nq values',q_values[0])\n",
        "        valid_actions = env._get_valid_actions()\n",
        "        print('current position',env.current_position)\n",
        "        print('valid actions', valid_actions)\n",
        "        \n",
        "        action = get_action(q_values, valid_actions, epsilon=0)\n",
        "        print('chosen action', action)\n",
        "        action_list.append(action)\n",
        "        # action = np.random.choice(valid_actions)\n",
        "        \n",
        "        next_state, _, _, _ = env.step(action)\n",
        "        current_state = next_state.copy()\n"
      ]
    },
