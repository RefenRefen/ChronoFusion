      ],
      "source": [
        "lower_tf_data = m5_data_filtered\n",
        "higher_tf_data = m30_data_filtered\n",
        "\n",
        "env = MultiTimeframeForexEnv(\n",
        "    lower_tf_data=lower_tf_data,\n",
        "    higher_tf_data=higher_tf_data,\n",
        "    walk_forward_window=100,\n",
        "    stop_loss_pct=0.001,\n",
        "    take_profit_pct=0.0011\n",
        ")\n",
        "\n",
        "\n",
        "windows = create_walk_forward_trainer(\n",
        "    total_steps=8000,\n",
        "    window_size=2000,\n",
        "    overlap=200\n",
        ")\n",
        "\n",
        "# print(f\"\\n=== Walk-Forward Training Windows ===\")\n",
        "# for i, window in enumerate(windows):\n",
        "#     print(f\"Window {i+1}:\")\n",
        "#     print(f\"  Train: {window['train_start']}-{window['train_end']}\")\n",
        "\n",
        "# Test first training window\n",
        "# print(f\"\\n=== Testing Window 1 ===\")\n",
        "\n",
        "window = windows[0]\n",
        "env.set_walk_forward_window(window['train_start'])\n",
        "\n",
        "state = env.reset()\n",
        "# print('start price:', env.get_current_price())\n",
        "# print(f\"State shape:\\n{state['data'][1]['mid_c'].tail()}\\n\")\n",
        "\n",
        "# Run training simulation\n",
        "total_reward = 0\n",
        "steps = 0\n",
        "trades = 0\n",
        "\n",
        "for step in range(1000):  # Test first 50 steps\n",
        "    # Get valid actions and choose one\n",
        "    valid_actions = env._get_valid_actions()\n",
        "    # print('valid actions:', valid_actions)\n",
        "    action = np.random.choice(valid_actions)\n",
        "    # print('chosen action', env.action_to_name(action))\n",
        "    next_state, reward, done, info = env.step(action)\n",
        "    # print('\\n\\n')\n",
        "    # print('current price:', env.get_current_price(), '\\n')\n",
        "    total_reward += reward\n",
        "    steps += 1\n",
        "    \n",
        "    if len(env.trade_history) > trades:\n",
        "        trades = len(env.trade_history)\n",
        "        print(f\"Step {steps}: Trade completed! Position={env.trade_history[-1]['position']}, Reward={reward:.6f}\")\n",
        "        print(f\"Entry Price:{env.trade_history[-1]['entry_price']}, Exit Price:{env.trade_history[-1]['exit_price']}, Balance: ${info['current_balance']:.2f}\")\n",
        "        print(f\"Price change: {env.trade_history[-1]['exit_price'] - env.trade_history[-1]['entry_price']}\\n\")\n",
        "        # print(f\"  Position: {info['current_position_size']}\")\n",
        "        # print(f\"  Window Progress: {info['window_progress']:.1%}\")\n",
        "    \n",
        "    if done:\n",
        "        # print(next_state)\n",
        "        print(f\"Episode terminated at step {steps}\")\n",
        "\n",
        "        break"
      ]
    },
