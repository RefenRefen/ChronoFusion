      ],
      "source": [
        "window_generator = TimeFrameWindowGen(m30_data_filtered, m5_data_filtered,\n",
        "                                      higher_window_size=5, lower_window_size=5)\n",
        "window_generator.alignment(0)\n",
        "print('lower_last', window_generator.lower_last_candle_index)\n",
        "print('higher_last', window_generator.higher_last_candle_index)\n",
        "\n",
        "for i in range(20):\n",
        "\n",
        "    if i == 10:\n",
        "        print('\\n\\n\\n')\n",
        "        window_generator.alignment(ltf_start_index=5000)\n",
        "        \n",
        "    h, l = window_generator.generate()\n",
        "    \n",
        "    curr_price = window_generator.get_current_value()[0]\n",
        "    print(h, '\\n')\n",
        "    print(l, '\\n')\n",
        "    print(curr_price, '\\n *************************')\n",
        "    "
      ]
    },
