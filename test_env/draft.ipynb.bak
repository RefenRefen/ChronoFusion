      "source": [
        "q_vals = q_network(x_low, x_high, pos_info)\n",
        "print('q_vals',q_vals)\n",
        "mask = torch.full_like(q_values, -1e9)  # very negative\n",
        "print('mask',mask)\n",
        "print('valid_actions', valid_actions)\n",
        "\n",
        "mask[0, valid_actions] = q_values[0, valid_actions]\n",
        "print('after masking', mask)\n",
        "act = torch.argmax(mask, dim=1).item()\n",
        "print(act)"
      ]
    },
