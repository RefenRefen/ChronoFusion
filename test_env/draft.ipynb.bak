            "2 2016-01-07 01:00:00+00:00    1323  1.07776  1.07990  1.07748  1.07966\n",
            "3 2016-01-07 01:30:00+00:00    1844  1.07968  1.08100  1.07931  1.08029\n",
            "4 2016-01-07 02:00:00+00:00     854  1.08026  1.08086  1.07996  1.08018\n",
            "5 2016-01-07 02:30:00+00:00     713  1.08014  1.08176  1.08008  1.08152 \n",
            "\n",
            "                        time  volume    mid_o    mid_h    mid_l    mid_c\n",
            "9  2016-01-07 02:25:00+00:00     158  1.08030  1.08040  1.07996  1.08018\n",
            "10 2016-01-07 02:30:00+00:00     123  1.08014  1.08068  1.08008  1.08051\n",
            "11 2016-01-07 02:35:00+00:00     233  1.08054  1.08146  1.08050  1.08128\n",
            "12 2016-01-07 02:40:00+00:00     105  1.08130  1.08172  1.08118  1.08148\n",
            "13 2016-01-07 02:45:00+00:00      65  1.08150  1.08168  1.08138  1.08146 \n",
            "\n",
            "1.08146 \n",
