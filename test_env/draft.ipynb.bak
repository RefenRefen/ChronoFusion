      "source": [
        "# def train():\n",
        "start = time.time()\n",
        "\n",
        "num_episodes = 2000\n",
        "# repeatation = 20\n",
        "max_num_timesteps = WALK_FORWARD_WINDOW \n",
        "\n",
        "total_point_history = []\n",
        "success_rate_history = []\n",
        "pnl_history = []\n",
        "balance_history = []\n",
        "num_p_av = 20    # number of total points to use for averaging  # 100\n",
        "epsilon = 1.0     # initial ε value for ε-greedy policy\n",
        "\n",
        "# Create a memory buffer D with capacity N\n",
        "memory_buffer = deque(maxlen=MEMORY_SIZE)\n",
        "\n",
        "target_q_network.load_state_dict(q_network.state_dict())\n",
        "#  TODO check if unnecessary device decleration \n",
        "\n",
        "step_counter = 0\n",
        "valid_range = env.window_generator.valid_idx(walk_forward_window=WALK_FORWARD_WINDOW)['ltf_range']\n",
        "for i in range(num_episodes):\n",
        "    \n",
        "    # Reset the environment to the initial state and get the initial state\n",
        "    # try:\n",
        "    #     state = env.reset()\n",
        "    # except:\n",
        "    #     env.window_generator.reset()\n",
        "    #     state = env.reset()\n",
        "    # x_low, x_high, pos_info = state_to_tensor(current_state)\n",
        "    \n",
        "    # n_candle_to_train\n",
        "\n",
        "    start_index = np.random.randint(valid_range[0], valid_range[1]) # 15 is the k period..\n",
        "    # print('\\t',start_index)\n",
        "    # of stochastic that makes nan in ltfdata\n",
        "    # print(\"start_index\", start_index)\n",
        "    env.window_generator.reset(idx_low=start_index)\n",
        "    state = env.reset()\n",
        "    \n",
        "\n",
        "    total_points = 0\n",
        "    \n",
        "    for t in range(max_num_timesteps):\n",
        "        # print('t', t)\n",
        "        # print(' higher last index',env.window_generator.higher_last_candle_index)\n",
        "        # print(' lower last index',env.window_generator.lower_last_candle_index)\n",
        "        # if step_counter >= lower_tf_data.shape[0] * 0.90:\n",
        "        #     env.window_generator.reset()\n",
        "        #     print(f'Window generator reset after {step_counter} steps.')\n",
        "        #     step_counter = 0\n",
        "        #     break\n",
        "\n",
        "        # From the current state S choose an action A using an ε-greedy policy\n",
        "        x_low, x_high, pos_info = state_to_tensor(state, device=device)    \n",
        "        # print('\\nx_low shape', x_low.shape)\n",
        "        # print('x_high shape', x_high.shape)    \n",
        "        # print('pos shape', pos_info.shape)\n",
        "        # print(state_qn)\n",
        "        q_values = q_network(x_low, x_high, pos_info)\n",
        "\n",
        "        valid_actions = env._get_valid_actions()\n",
        "        action = get_action(q_values, valid_actions, epsilon)\n",
        "        # action = np.random.choice(valid_actions)\n",
        "        \n",
        "        \n",
        "        next_state, reward, done, info = env.step(action)\n",
        "        # print('current_price',env.get_current_price())\n",
        "        # print(next_state['htf_data'], '\\n')\n",
        "        # print(next_state['position_info'])\n",
        "        # try:\n",
        "        #     next_state, reward, done, info = env.step(action)\n",
        "        # except:\n",
        "        #     # env.window_generator.reset()\n",
        "        #     # next_state, reward, done, info = env.step(action)\n",
        "        #     break\n",
        "        \n",
        "        # print(f\" action: {env.action_to_name(action)}, reward: {reward}\")\n",
        "        # if done:\n",
        "        #     break\n",
        "        # print()\n",
        "        \n",
        "        # Store experience tuple (S,A,R,S') in the memory buffer.\n",
        "        # We store the done variable as well for convenience.\n",
        "        # if step_counter <= lower_tf_data.shape[0] * 0.98:\n",
        "        # Store packed numeric arrays in replay to avoid huge DataFrame objects.\n",
        "        memory_buffer.append(\n",
        "            experience(pack_state(state), action, reward, pack_state(next_state), done)\n",
        "        )\n",
        "        step_counter += 1 \n",
        "        \n",
        "        # Only update the network every NUM_STEPS_FOR_UPDATE time steps.\n",
        "        update = check_update_conditions(t, NUM_STEPS_FOR_UPDATE, memory_buffer)\n",
        "        \n",
        "        if update:\n",
        "            # Sample random mini-batch of experience tuples (S,A,R,S') from D\n",
        "            experiences = get_experiences(memory_buffer, device=device)\n",
        "            \n",
        "            # Set the y targets, perform a gradient descent step,\n",
        "            # and update the network weights.\n",
        "            agent_learn(experiences, GAMMA, device=device)\n",
        "        # print(reward)\n",
        "\n",
        "        state = next_state.copy()\n",
        "        total_points += reward\n",
        "        \n",
        "        if done:\n",
        "            # print(f'\\tdone in step {t}, reward:{reward}')\n",
        "            break\n",
        "            \n",
        "        # if t> 10: \n",
        "        #     break\n",
        "\n",
        "    # if i % num_episodes == 0:\n",
        "    #     env.window_generator.alignment(0)\n",
        "\n",
        "    success_counter = 0\n",
        "    total_pnl_per_episode = 0\n",
        "\n",
        "    for trade in env.trade_history:\n",
        "        if trade['success']:\n",
        "            success_counter += 1\n",
        "        total_pnl_per_episode += trade['pnl']  \n",
        "    \n",
        "    mean_pnl = total_pnl_per_episode/(len(env.trade_history)+1)\n",
        "    pnl_history.append(mean_pnl)\n",
        "\n",
        "    success_rate = success_counter/(len(env.trade_history)+1)\n",
        "    success_rate_history.append(success_rate)\n",
        "\n",
        "    total_point_history.append(total_points)\n",
        "    av_latest_points = np.mean(total_point_history[-num_p_av:])\n",
        "\n",
        "    if av_latest_points > 10000:\n",
        "        break\n",
        "    \n",
        "    epsilon = get_new_eps(epsilon)\n",
        "    print(f\"\\rEpisode {i+1} | Total point average of the last {num_p_av} episodes: {av_latest_points:.2f}\", end=\"\")\n",
        "    # eplilon: {epsilon:.2f}, memory: {len(memory_buffer)}\n",
        "    if (i+1) % num_p_av == 0:\n",
        "        print(f\"\\rEpisode {i+1} | Total point average of the last {num_p_av} episodes: {av_latest_points:.2f}\")\n",
        "\n",
        "    # We will consider that the environment is solved if we get an\n",
        "    # average of 200 points in the last 100 episodes.\n",
        "    # if av_latest_points >= 200.0:\n",
        "    #     print(f\"\\n\\nEnvironment solved in {i+1} episodes!\")\n",
        "    #     q_network.save('lunar_lander_model.h5')\n",
        "    #     break\n",
        "        \n",
        "         \n",
        "tot_time = time.time() - start\n",
        "\n",
        "\n",
        "\n",
        "print(f\"\\nTotal Runtime: {tot_time:.2f} s ({(tot_time/60):.2f} min)\")\n",
        "    # print(q_values, action)\n",
        "torch.save(q_network.state_dict(), \"test_env_data/converged_model.pth\")\n",
        "torch.save(q_network.state_dict(), \"converged_model.pth\")\n",
        "\n",
        "# train()\n"
      ]
    },
    {
